      m_PersistentCalls:
        m_Calls: []
  - id: radio_aviso
    speaker: "R\xE1dio"
    text: "Voc\xEAs pegaram a chave? N\xE3o des\xE7am sem lanterna. Ele escuta tudo
      o que voc\xEAs fazem."
    voice: {fileID: 0}
    seconds: 0
    once: 1
    requiresVariable: has_cellar_key
    setVariable: 
    onFinished:
      m_PersistentCalls:
        m_Calls: []
