%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8e36a67d50fd724692874dfd09ff649, type: 3}
  m_Name: GameCatalog
  m_EditorClassIdentifier: Assembly-CSharp::HorrorFPS.GameCatalog
  mainMenuScene: MainMenu
  coreScene: Core
  noPlayerScenes: []
  hotbarSlots: 9
  gameTitle: Huggable Horrors
  firstLevel: hall
  levels:
  - id: hall
    displayName: "Sal\xE3o"
    scenes:
    - Level_Hall
    defaultSpawn: start
    loadingTip: "Segure o bot\xE3o de interagir para pular uma cutscene."
  - id: cellar
    displayName: "Por\xE3o"
    scenes:
    - Level_Cellar
    defaultSpawn: start
    loadingTip: Use o gravador para salvar o jogo. Checkpoints salvam sozinhos.
  - id: tunnels
    displayName: "T\xFAneis"
    scenes:
    - Level_Tunnels
    defaultSpawn: start
    loadingTip: 'Quando a sanidade cai, as luzes falham. Fique agachado no escuro:
      o monstro enxerga menos.'
  - id: power
    displayName: "Casa de for\xE7a"
    scenes:
    - Level_Power
    defaultSpawn: start
    loadingTip: 'Um atalho aberto fica aberto: volte por ele e poupe o caminho.'
  loadingTips:
  - "Dois jogadores? Aperte um bot\xE3o no segundo controle para entrar."
  - "Objetos que voc\xEA move continuam onde voc\xEA deixou, mesmo depois de trocar
    de n\xEDvel."
  - "Nem tudo que se mexe no escuro \xE9 a sua imagina\xE7\xE3o."
